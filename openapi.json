                            }
                        }
                    }
                },
                "responses": { "201": { "description": "Linked" } }
            },
            "delete": {
                "summary": "Unlink user from team",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
