                    }
                ],
                "responses": { "200": { "description": "OK" } }
            }
        },
        "/user-projects": {
            "post": {
                "summary": "Link user to project",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UserProjectLink"
                            }
                        }
                    }
                },
                "responses": { "201": { "description": "Linked" } }
            },
            "delete": {
                "summary": "Unlink user from project",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UserProjectLink"
                            }
                        }
                    }
                },
                "responses": { "204": { "description": "Unlinked" } }
            }
        },
        "/user-tasks": {
            "post": {
                "summary": "Link user to task",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UserTaskLink"
                            }
                        }
                    }
                },
                "responses": { "201": { "description": "Linked" } }
            },
            "delete": {
                "summary": "Unlink user from task",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UserTaskLink"
                            }
                        }
                    }
                },
                "responses": { "204": { "description": "Unlinked" } }
            }
