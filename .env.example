PORT=3000
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/splitease?sslmode=require
LOG_LEVEL=info

# Neon Auth - find these in your Neon project's Auth settings.
# NEON_AUTH_BASE_URL is your Neon Auth service's base URL (its origin
# is used as the expected JWT issuer). NEON_AUTH_JWKS_URL is its
# published public-keys endpoint, used to verify token signatures.
NEON_AUTH_BASE_URL=https://your-project.neon.tech/auth
NEON_AUTH_JWKS_URL=https://your-project.neon.tech/auth/jwks